{
  "name": "codelight",
  "version": "0.4.3",
  "description": "CodeLight — physical BLE status lights and desktop notifications for coding agents",
  "main": "electron/main.js",
  "type": "commonjs",
  "author": "wqytommy",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "check": "node --check electron/main.js && node --check electron/preload.js && node --check src/renderer.js && node --check src/ble-controller.js && node --test tests/*.test.js",
    "build:mac": "electron-builder --mac dmg zip --config.electronDist=node_modules/electron/dist",
    "build:win": "electron-builder --win nsis portable --x64",
    "pack:mac": "electron-builder --mac dir"
  },
  "devDependencies": {
    "electron": "40.10.2",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "build": {
    "appId": "com.local.agent-status-light",
    "productName": "CodeLight",
    "afterPack": "scripts/after-pack.js",
    "asar": true,
    "files": [
      "electron/**/*",
      "shared/**/*",
      "src/**/*",
      "resources/icon.png",
      "resources/codelight-logo.png",
      "resources/trayTemplate*.png",
      "resources/trayTemplate.svg",
      "resources/providers/**/*",
      "LICENSE",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "resources/icon.icns",
      "extraResources": [
        {
          "from": "scripts",
          "to": "scripts"
        },
        {
          "from": "resources/integrations",
          "to": "integrations"
        },
        {
          "from": "../agent_light.py",
          "to": "backend/agent_light.py"
        },
        {
          "from": "../status_watch.py",
          "to": "backend/status_watch.py"
        },
        {
          "from": "../.build/agent-light-daemon",
          "to": "backend/macos/agent-light-daemon"
        },
        {
          "from": "../device.id",
          "to": "backend/device.id"
        }
      ],
      "extendInfo": {
        "NSBluetoothAlwaysUsageDescription": "CodeLight 连接 JTX-RGB 状态灯并显示 AI 编程工具任务状态。",
        "LSUIElement": false
      }
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "resources/icon.ico",
      "extraResources": [
        {
          "from": "scripts",
          "to": "scripts"
        },
        {
          "from": "resources/integrations",
          "to": "integrations"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
